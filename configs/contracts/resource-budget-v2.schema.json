      },
      "allOf": [
        {
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "independent_experts"
              }
            }
          },
          "then": {
            "required": [
              "supported",
              "evidence"
            ]
          }
        }
      ],
      "description": "Independent expert branches must declare supported and evidence; missing keys are reported as unknown inputs, never as a measured speedup."
